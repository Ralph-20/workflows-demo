# Optional. Enables real model calls on tab 06 ("Agents on workflows") through
# the Vercel AI Gateway. Without it, tab 06 uses a deterministic mock model and
# shows a MOCK badge — the workflow around the model still runs for real.
AI_GATEWAY_API_KEY=

# Required for local runs only (`pnpm build && pnpm start`). Routes workflow
# state to the Local World, which writes to ./.workflow-data/.
# On Vercel this is unset: deployments use the Vercel World automatically.
WORKFLOW_TARGET_WORLD=local
